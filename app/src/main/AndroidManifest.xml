<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DAMFlix">

        <!--  MainActivity: -->
        <!--  Cambié el "exported" y moví el "intent-filter" para
              visualizar esta activity en el emulador
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DAMFlix"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--  MovieFormActivity: -->
        <activity
            android:name=".MovieFormActivity"
            android:exported="false"
            android:theme="@style/Theme.DAMFlix"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <!--  MovieCatalogActivity: -->
        <activity
            android:name=".MovieCatalogActivity"
            android:exported="true"
            android:theme="@style/Theme.DAMFlix"
            android:windowSoftInputMode="adjustResize">
        </activity>
    </application>

</manifest>